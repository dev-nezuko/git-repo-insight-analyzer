PORT=4000

# Local MongoDB. docker compose sets this for you.
MONGODB_URI=mongodb://127.0.0.1:27017/codebase-investigator
# Atlas / Render: paste the full URI from Atlas > Connect > Drivers (host looks like cluster0.abcd.mongodb.net).
# Percent-encode @ # / : in the password (e.g. @ -> %40), or the driver reads @ as the host separator.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/codebase-investigator?retryWrites=true&w=majority

# Browser origins allowed to call the API (comma-separated). Not needed when the server also serves the UI.
CORS_ORIGINS=http://localhost:5173

# Repository imports
IMPORT_MAX_ARCHIVE_MB=50
# Where zipballs are fetched from. Only change it for GitHub Enterprise or an offline stand-in.
GITHUB_API_URL=https://api.github.com

# Optional: OpenAI synthesis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1

# Optional: AWS Bedrock synthesis (when all four are set, tried before OpenAI).
# Prefer an IAM role in production; never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Tests only: the MongoDB server the suite creates throwaway databases on.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/codebase-investigator-test
